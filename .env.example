# Server-only. Set separate preview and production values through Vercel.
# Keep disabled until verified-domain and isolated live-test checks are complete.
EMAIL_CONFIRMATION_ENABLED=false
A305X_SITE_URL=https://www.a305x.com
# Bare sender address on a Resend-verified domain. Do not use the public Gmail address here.
A305X_EMAIL_FROM=
# Existing monitored support address can be used as Reply-To.
A305X_EMAIL_REPLY_TO=orionmind@gmail.com
RESEND_API_KEY=
# Generate 32 random bytes encoded as base64url. Store as a Vercel Secret.
A305X_TOKEN_SECRET=
# Reuse the EXISTING private store. Do not replace it or connect previews to production data.
# Configure the existing Blob SDK's OIDC binding or BLOB_READ_WRITE_TOKEN in Vercel.
