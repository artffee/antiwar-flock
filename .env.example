# Preserve the existing PRIVATE Blob store. Never point Production at a new
# empty store or give Preview the production subscriber credentials.
BLOB_READ_WRITE_TOKEN=
# OR the store's supported Vercel OIDC configuration; keep the existing setup.

# Sending starts disabled. No automatic legacy reconfirmation or campaigns.
EMAIL_ENABLED=false
EMAIL_MARKETING_ENABLED=false
# off by default. test restricts recipients; live is accepted only on Production.
EMAIL_DELIVERY_MODE=off
EMAIL_SITE_URL=https://www.a305x.com
RESEND_API_KEY=
EMAIL_FROM=A305X <updates@a305x.com>
# Must exactly match the domain of EMAIL_FROM, after provider verification.
EMAIL_SENDER_DOMAIN=a305x.com
EMAIL_REPLY_TO=orionmind@gmail.com
# A separate random secret, at least 32 bytes. Keep stable to preserve email links.
EMAIL_TOKEN_SECRET=
RESEND_WEBHOOK_SECRET=
# A different random secret (at least 32 characters) for the operator endpoint.
EMAIL_ADMIN_SECRET=
# Owner-approved physical BUSINESS mailing address; required for marketing.
EMAIL_POSTAL_ADDRESS=
# Comma-separated owner-approved test addresses, for controlled confirmation tests.
EMAIL_TEST_RECIPIENTS=
# PREVIEW ONLY: a genuinely different private store. The inherited normal Blob
# credential is rejected. Never copy the production token into this variable.
EMAIL_PREVIEW_BLOB_READ_WRITE_TOKEN=
# Optional unsubscribe-only compatibility with PR #2 links, IF ever issued.
# Preserve that deployment's original secret; do not generate a replacement.
A305X_TOKEN_SECRET=
# Campaigns have an additional source-code lock. No env flag unlocks this release.
